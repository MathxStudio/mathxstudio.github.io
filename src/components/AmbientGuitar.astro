---
interface Track {
  title: string;
  artist: string;
  streamUrl: string;
  sourceUrl: string;
}

const tracks: Track[] = [
  {
    title: 'Recuerdos de la Alhambra',
    artist: 'Francisco Tárrega',
    streamUrl: 'https://upload.wikimedia.org/wikipedia/commons/a/a3/Recuerdos_de_la_Alhambra.ogg',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Recuerdos_de_la_Alhambra.ogg',
  },
  {
    title: 'Romance Anónimo',
    artist: 'Jeux interdits',
    streamUrl: 'https://upload.wikimedia.org/wikipedia/commons/3/33/Romance_An%C3%B3nimo_%28Jeux_interdits%29.ogg',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Romance_An%C3%B3nimo_(Jeux_interdits).ogg',
  },
  {
    title: 'Romance (Jeux interdits)',
    artist: 'Kaori Muraji (村治佳织)',
    streamUrl:
      'https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/b2/c5/17/b2c517e3-ea61-e8e6-0a15-f1dacafaefdd/mzaf_15705116180618425976.plus.aac.p.m4a',
    sourceUrl: 'https://music.apple.com/us/album/romance-from-jeux-interdits/1451973161?i=1451973385',
  },
  {
    title: 'Variations on a Theme of Mozart, Op. 9',
    artist: 'John Williams · Sor',
    streamUrl:
      'https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview125/v4/97/3d/cf/973dcfc0-a97f-a8b9-b87c-750d65b7cb4c/mzaf_11907403565604175300.plus.aac.p.m4a',
    sourceUrl: 'https://music.apple.com/us/album/variations-on-a-theme-of-mozart-op-9/893373787?i=893373866',
  },
  {
    title: 'Cavatina',
    artist: 'John Williams · Stanley Myers',
    streamUrl:
      'https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview221/v4/87/17/50/87175056-8e8c-31cf-b8c5-46e14043bd89/mzaf_1892102775097299705.plus.aac.p.m4a',
    sourceUrl: 'https://music.apple.com/us/album/cavatina/161725510?i=161726191',
  },
  {
    title: 'Variations on "Gentil Housard", Op. 27',
    artist: 'Kazuhito Yamashita (山下和仁) · Sor',
    streamUrl:
      'https://audio-ssl.itunes.apple.com/itunes-assets/AudioPreview211/v4/51/c4/3f/51c43fc3-388c-5f65-44c8-51914a0434d4/mzaf_3060202344971169405.plus.aac.p.m4a',
    sourceUrl:
      'https://music.apple.com/us/album/introduction-et-variations-sur-lair-gentil-housard/1814578021?i=1814578134',
  },
];
---

<aside class="guitar-dock" aria-label="Guitar">
  <div id="guitar-panel" class="guitar-panel" hidden>
    <ul class="track-list">
      {tracks.map((track, idx) => (
        <li class="track-item">
          <button
            type="button"
            class="track-select"
            data-index={idx}
            data-src={track.streamUrl}
            data-title={track.title}
            data-artist={track.artist}
          >
            <span class="track-name">{track.title}</span>
            <span class="track-artist">{track.artist}</span>
          </button>
          <a
            href={track.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ext-link"
            title="Source"
            aria-label={`Source: ${track.title}`}
          >
            ↗
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="guitar-pill">
    <button
      id="guitar-play"
      type="button"
      class="wave-btn"
      data-playing="false"
      aria-label="Play or pause"
    >
      <span class="waveform" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </span>
    </button>
    <span id="guitar-current" class="pill-label">
      {tracks[0].title} · {tracks[0].artist}
    </span>
    <button id="guitar-toggle" type="button" class="pill-btn" aria-expanded="false" aria-label="Tracklist">
      +
    </button>
  </div>

  <audio id="guitar-audio" preload="none" src={tracks[0].streamUrl}></audio>
</aside>

<script>
  const audio = document.getElementById('guitar-audio') as HTMLAudioElement | null;
  const playBtn = document.getElementById('guitar-play');
  const toggleBtn = document.getElementById('guitar-toggle');
  const panel = document.getElementById('guitar-panel');
  const currentLabel = document.getElementById('guitar-current');
  const trackBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.track-select'));

  const TARGET_VOLUME = 0.45;
  let currentIndex = 0;
  let fadeFrame = 0;
  let fadingOut = false;

  function setPlayingState(playing: boolean) {
    playBtn?.setAttribute('data-playing', String(playing));
  }

  function highlightTrack(index: number) {
    trackBtns.forEach((btn, idx) => {
      btn.setAttribute('aria-current', idx === index ? 'true' : 'false');
    });
  }

  function fadeTo(target: number, durationMs: number, onDone?: () => void) {
    if (!audio) return;
    cancelAnimationFrame(fadeFrame);
    const startVol = audio.volume;
    const delta = target - startVol;
    if (durationMs <= 0 || Math.abs(delta) < 0.005) {
      audio.volume = Math.max(0, Math.min(1, target));
      onDone?.();
      return;
    }

    const startTime = performance.now();
    const step = (now: number) => {
      const progress = Math.min(1, (now - startTime) / durationMs);
      audio.volume = Math.max(0, Math.min(1, startVol + delta * progress));
      if (progress < 1) {
        fadeFrame = requestAnimationFrame(step);
      } else {
        onDone?.();
      }
    };
    fadeFrame = requestAnimationFrame(step);
  }

  function startPlayback() {
    if (!audio) return;
    fadingOut = false;
    audio.volume = 0;
    audio
      .play()
      .then(() => {
        fadeTo(TARGET_VOLUME, 1800);
      })
      .catch(() => {
        setPlayingState(false);
      });
  }

  function loadTrack(index: number, autoPlay = false) {
    if (!audio || !trackBtns[index]) return;
    const btn = trackBtns[index];
    const src = btn.dataset.src || '';
    const title = btn.dataset.title || '';
    const artist = btn.dataset.artist || '';

    const applyTrack = () => {
      currentIndex = index;
      if (audio.src !== src) {
        audio.src = src;
      }
      if (currentLabel) {
        currentLabel.textContent = `${title} · ${artist}`;
      }
      highlightTrack(index);
      if (autoPlay) {
        startPlayback();
      }
    };

    if (autoPlay && !audio.paused) {
      fadingOut = true;
      fadeTo(0, 300, applyTrack);
    } else {
      applyTrack();
    }
  }

  highlightTrack(0);

  playBtn?.addEventListener('click', () => {
    if (!audio) return;
    if (audio.paused) {
      startPlayback();
    } else {
      fadingOut = true;
      fadeTo(0, 300, () => {
        audio.pause();
        fadingOut = false;
      });
    }
  });

  audio?.addEventListener('play', () => setPlayingState(true));
  audio?.addEventListener('pause', () => setPlayingState(false));

  audio?.addEventListener('timeupdate', () => {
    if (!audio || fadingOut || !Number.isFinite(audio.duration) || audio.duration <= 6) return;
    const remaining = audio.duration - audio.currentTime;
    if (remaining > 0 && remaining <= 2.8) {
      fadingOut = true;
      fadeTo(0, remaining * 1000);
    }
  });

  audio?.addEventListener('ended', () => {
    fadingOut = false;
    const next = (currentIndex + 1) % trackBtns.length;
    loadTrack(next, true);
  });

  trackBtns.forEach((btn, idx) => {
    btn.addEventListener('click', () => loadTrack(idx, true));
  });

  toggleBtn?.addEventListener('click', () => {
    if (!panel || !toggleBtn) return;
    const open = panel.hidden;
    panel.hidden = !open;
    toggleBtn.setAttribute('aria-expanded', String(open));
    toggleBtn.textContent = open ? '–' : '+';
  });
</script>

<style>
  .guitar-dock {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 30;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    max-width: calc(100vw - 2rem);
  }
  .guitar-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.3rem 0.45rem;
    max-width: 100%;
  }
  .wave-btn,
  .pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border);
    height: 1.55rem;
    padding: 0 0.45rem;
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
  }
  .wave-btn:hover,
  .pill-btn:hover {
    border-color: var(--fg);
  }
  .waveform {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 0.85rem;
  }
  .waveform i {
    display: block;
    width: 2px;
    background: currentColor;
    transform-origin: center;
  }
  .waveform i:nth-child(1) {
    height: 38%;
  }
  .waveform i:nth-child(2) {
    height: 75%;
  }
  .waveform i:nth-child(3) {
    height: 50%;
  }
  .waveform i:nth-child(4) {
    height: 90%;
  }
  .waveform i:nth-child(5) {
    height: 45%;
  }
  .wave-btn[data-playing='true'] .waveform i {
    animation: wave-pulse 1.1s ease-in-out infinite alternate;
  }
  .wave-btn[data-playing='true'] .waveform i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .wave-btn[data-playing='true'] .waveform i:nth-child(3) {
    animation-delay: 0.36s;
  }
  .wave-btn[data-playing='true'] .waveform i:nth-child(4) {
    animation-delay: 0.12s;
  }
  .wave-btn[data-playing='true'] .waveform i:nth-child(5) {
    animation-delay: 0.28s;
  }
  @keyframes wave-pulse {
    0% {
      transform: scaleY(0.35);
    }
    100% {
      transform: scaleY(1);
    }
  }
  .pill-label {
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 14rem;
  }
  .guitar-panel {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.55rem 0.7rem;
    margin-bottom: 0.4rem;
    width: min(23rem, calc(100vw - 2rem));
  }
  .track-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .track-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
  }
  .track-item:last-child {
    border-bottom: none;
  }
  .track-select {
    background: transparent;
    border: none;
    color: var(--fg);
    font: inherit;
    text-align: left;
    padding: 0;
    cursor: pointer;
    flex: 1;
    min-width: 0;
  }
  .track-select[aria-current='true'] .track-name {
    font-weight: 700;
    text-decoration: underline;
  }
  .track-name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .track-artist {
    display: block;
    color: var(--muted);
    font-size: 0.72rem;
  }
  .ext-link {
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--border);
    padding: 0.05rem 0.35rem;
  }
  .ext-link:hover {
    color: var(--fg);
    border-color: var(--fg);
  }
</style>
