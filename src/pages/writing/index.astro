---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, defaultLang } from '../../i18n/ui';

const t = useTranslations(defaultLang);
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={t('nav.writing')} description={t('writing.description')}>
  <section class="desktop-split">
    <div>
      <h1>{t('nav.writing')}</h1>
      <p class="muted">{t('writing.description')}</p>
    </div>

    <div>
      {posts.length === 0 ? (
        <p class="muted">{t('post.empty')}</p>
      ) : (
        <ul class="entry-list">
          {posts.map((post) => (
            <li class="entry-item">
              <div class="entry-meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                {post.data.tags.map((tag) => (
                  <span class="badge">#{tag}</span>
                ))}
                {post.data.zhihuUrl && (
                  <a href={post.data.zhihuUrl} target="_blank" rel="noopener noreferrer" class="zhihu-link">
                    {t('post.zhihu')}
                  </a>
                )}
              </div>
              <a href={`/writing/${post.id}`} class="entry-title">
                {post.data.title}
              </a>
              {post.data.description && <p class="entry-desc">{post.data.description}</p>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 0.5rem;
  }
  .muted {
    margin: 0;
    color: var(--muted);
  }
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .entry-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .entry-item:first-child {
    padding-top: 0;
  }
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }
  .badge {
    border: 1px solid var(--border);
    padding: 0.05rem 0.4rem;
  }
  .zhihu-link {
    text-decoration: none;
    border: 1px solid var(--border);
    padding: 0.05rem 0.4rem;
  }
  .entry-title {
    display: inline-block;
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
  }
  .entry-title:hover {
    text-decoration: underline;
  }
  .entry-desc {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
